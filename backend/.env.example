PORT=5001
CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret

# Required values:
# PORT: Express server port.
# CONNECTION_STRING: MongoDB connection URI for this project database.
# ACCESS_TOKEN_SECRET: Secret used to sign and verify JWT access tokens.
